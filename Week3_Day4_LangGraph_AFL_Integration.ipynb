    "# Task 5 — 10 end-to-end conversations\n",
    "\n",
    "conversations = [\n",
    "    (\"C1\", [\"What is an AFL mark?\" ]),\n",
    "    (\"C2\", [\"What were the Pies' stats last round?\"]),\n",
    "    (\"C3\", [\"Who will win Collingwood vs Geelong?\"]),\n",
    "    (\"C4\", [\"Who will top-score for the Cats?\"]),\n",
    "    (\"C5\", [\"Tell me a Python joke.\"]),\n",
    "    (\"C6\", [\"What were the stats last round?\"]),\n",
    "    (\"C7\", [\"Predict Collingwood's tackles next week.\"]),\n",
    "    (\"C8\", [\"Will the Pies beat the Cats this week?\"]),\n",
    "    (\"C9\", [\"Who will win Collingwood vs Geelong?\", \"What about the top scorer for Collingwood?\"]),\n",
    "    (\"C10\", [\"How many goals did the Pies score last round?\"])\n",
    "]\n",
    "\n",
    "results=[]\n",
    "for cid, turns in conversations:\n",
    "    history=[]\n",
    "    last=None\n",
    "    for turn in turns:\n",
    "        last=run_app(turn, history)\n",
    "        history.append({\"role\":\"user\",\"content\":turn})\n",
    "        history.append({\"role\":\"assistant\",\"content\":last[\"final_response\"]})\n",
    "    results.append({\n",
    "        \"Conversation\":cid,\n",
    "        \"Turns\":len(turns),\n",
    "        \"Intent\":last.get(\"intent\"),\n",
    "        \"Final response\":last[\"final_response\"]\n",
    "    })\n",
    "\n",
    "e2e=pd.DataFrame(results)\n",
    "e2e[[\"Conversation\",\"Turns\",\"Intent\",\"Final response\"]]\n"
