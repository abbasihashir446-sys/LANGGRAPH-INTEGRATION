    "# Task 3 — Data preparation and Day 2 prediction models\n",
    "\n",
    "aliases = {\n",
    "    \"pies\":\"Collingwood Magpies\", \"collingwood\":\"Collingwood Magpies\",\n",
    "    \"cats\":\"Geelong Cats\", \"geelong\":\"Geelong Cats\",\n",
    "    \"bombers\":\"Essendon Bombers\", \"essendon\":\"Essendon Bombers\",\n",
    "    \"blues\":\"Carlton Blues\", \"carlton\":\"Carlton Blues\",\n",
    "    \"tigers\":\"Richmond Tigers\", \"richmond\":\"Richmond Tigers\",\n",
    "    \"hawks\":\"Hawthorn Hawks\", \"hawthorn\":\"Hawthorn Hawks\",\n",
    "    \"swans\":\"Sydney Swans\", \"sydney\":\"Sydney Swans\",\n",
    "    \"lions\":\"Brisbane Lions\", \"brisbane\":\"Brisbane Lions\",\n",
    "    \"dees\":\"Melbourne Demons\", \"melbourne\":\"Melbourne Demons\",\n",
    "    \"dogs\":\"W. Bulldogs\", \"bulldogs\":\"W. Bulldogs\", \"western bulldogs\":\"W. Bulldogs\",\n",
    "    \"saints\":\"St Kilda Saints\", \"st kilda\":\"St Kilda Saints\",\n",
    "    \"eagles\":\"West Coast Eagles\", \"west coast\":\"West Coast Eagles\",\n",
    "    \"power\":\"Port Adelaide Power\", \"port adelaide\":\"Port Adelaide Power\",\n",
    "    \"crows\":\"Adelaide Crows\", \"adelaide\":\"Adelaide Crows\",\n",
    "    \"giants\":\"Greater Western Sydney Giants\", \"gws\":\"Greater Western Sydney Giants\"\n",
    "}\n",
    "\n",
    "def normalize_team(x):\n",
    "    s = str(x).strip()\n",
    "    return aliases.get(s.lower(), s)\n",
    "\n",
    "team_matches[\"team_name\"] = team_matches[\"team_name\"].map(normalize_team)\n",
    "team_matches[\"opponent\"] = team_matches[\"opponent\"].map(normalize_team)\n",
    "team_matches[\"match_date\"] = pd.to_datetime(team_matches[\"match_date\"], errors=\"coerce\")\n",
    "team_matches = team_matches.dropna(subset=[\"team_name\",\"opponent\",\"match_date\",\"result\"]).sort_values(\"match_date\")\n",
    "\n",
    "# Create leakage-safe pre-match rolling features.\n",
    "history = {}\n",
    "rows = []\n",
    "for _, r in team_matches.iterrows():\n",
    "    team, opp = r.team_name, r.opponent\n",
    "\n",
    "    def previous_stats(items):\n",
    "        if not items:\n",
    "            return 0.5, 0.0, 0.0\n",
    "        last = items[-5:]\n",
    "        return (\n",
    "            np.mean([x[0] for x in last]),\n",
    "            np.mean([x[1] for x in last]),\n",
    "            np.mean([x[2] for x in last])\n",
    "        )\n",
    "\n",
    "    twr, tmargin, tscore = previous_stats(history.get(team, []))\n",
    "    owr, omargin, oscore = previous_stats(history.get(opp, []))\n",
    "\n",
    "    win = int(str(r.result).upper() == \"W\")\n",
    "    margin = float(r.margin) if pd.notna(r.margin) else 0.0\n",
    "    signed_margin = margin if win else -margin\n",
    "    score = float(r.team_score) if pd.notna(r.team_score) else 0.0\n",
    "\n",
    "    rows.append({\n",
    "        \"date\": r.match_date, \"year\": int(r.year),\n",
    "        \"team\": team, \"opp\": opp, \"win\": win,\n",
    "        \"wr_diff\": twr - owr,\n",
    "        \"margin_diff\": tmargin - omargin,\n",
    "        \"score_diff\": tscore - oscore,\n",
    "        \"home_flag\": int(str(r.home_away).upper() == \"H\")\n",
    "    })\n",
    "\n",
    "    history.setdefault(team, []).append((win, signed_margin, score))\n",
    "\n",
    "match_features = pd.DataFrame(rows)\n",
    "\n",
    "match_cols = [\"wr_diff\",\"margin_diff\",\"score_diff\",\"home_flag\"]\n",
    "match_model = Pipeline([\n",
    "    (\"scale\", StandardScaler()),\n",
    "    (\"model\", LogisticRegression(max_iter=1000))\n",
    "])\n",
    "match_train = match_features[match_features.year < 2025]\n",
    "match_test = match_features[match_features.year == 2025]\n",
    "match_model.fit(match_train[match_cols], match_train[\"win\"])\n",
    "\n",
    "match_pred = match_model.predict(match_test[match_cols])\n",
    "match_prob = match_model.predict_proba(match_test[match_cols])[:,1]\n",
    "print(\"Match model accuracy (2025 hold-out):\", round(accuracy_score(match_test[\"win\"], match_pred), 3))\n",
    "print(\"Match model ROC AUC (2025 hold-out):\", round(roc_auc_score(match_test[\"win\"], match_prob), 3))\n",
    "\n",
    "# Top-player model: use lagged 3-game form to predict the next game's fantasy points.\n",
    "round_stats[\"match_date\"] = pd.to_datetime(round_stats[\"match_date\"], errors=\"coerce\")\n",
    "round_stats[\"team\"] = round_stats[\"team\"].map(normalize_team)\n",
    "round_stats[\"opponent\"] = round_stats[\"opponent\"].map(normalize_team)\n",
    "round_stats[\"fantasy_points\"] = pd.to_numeric(round_stats[\"fantasy_points\"], errors=\"coerce\").fillna(0)\n",
    "round_stats = round_stats.dropna(subset=[\"player_id\",\"match_date\"]).sort_values([\"player_id\",\"match_date\"])\n",
    "\n",
    "info[\"player_name\"] = info[\"player_name\"].astype(str)\n",
    "player_names = dict(zip(info[\"id\"], info[\"player_name\"]))\n",
    "\n",
    "for col in [\"disposals\",\"goals\",\"marks\",\"tackles\"]:\n",
    "    round_stats[col] = pd.to_numeric(round_stats[col], errors=\"coerce\").fillna(0)\n",
    "\n",
    "g = round_stats.groupby(\"player_id\")\n",
    "round_stats[\"prev_fantasy_3\"] = g[\"fantasy_points\"].transform(lambda s: s.shift(1).rolling(3,min_periods=1).mean())\n",
    "round_stats[\"prev_disposals_3\"] = g[\"disposals\"].transform(lambda s: s.shift(1).rolling(3,min_periods=1).mean()).fillna(0)\n",
    "round_stats[\"prev_goals_3\"] = g[\"goals\"].transform(lambda s: s.shift(1).rolling(3,min_periods=1).mean()).fillna(0)\n",
    "round_stats[\"prev_marks_3\"] = g[\"marks\"].transform(lambda s: s.shift(1).rolling(3,min_periods=1).mean()).fillna(0)\n",
    "round_stats[\"prev_tackles_3\"] = g[\"tackles\"].transform(lambda s: s.shift(1).rolling(3,min_periods=1).mean()).fillna(0)\n",
    "\n",
    "player_cols = [\"prev_fantasy_3\",\"prev_disposals_3\",\"prev_goals_3\",\"prev_marks_3\",\"prev_tackles_3\"]\n",
    "player_data = round_stats.dropna(subset=[\"prev_fantasy_3\"]).copy()\n",
    "player_train = player_data[player_data.match_date.dt.year < 2025]\n",
    "player_test = player_data[player_data.match_date.dt.year == 2025]\n",
    "sample_train = player_train.sample(min(60000, len(player_train)), random_state=42)\n",
    "\n",
    "player_model = RandomForestRegressor(\n",
    "    n_estimators=80, max_depth=8, min_samples_leaf=5,\n",
    "    random_state=42, n_jobs=-1\n",
    ")\n",
    "player_model.fit(sample_train[player_cols], sample_train[\"fantasy_points\"])\n",
    "player_mae = mean_absolute_error(\n",
    "    player_test[\"fantasy_points\"],\n",
    "    player_model.predict(player_test[player_cols])\n",
    ")\n",
    "print(\"Top-player model MAE (2025 hold-out):\", round(player_mae, 2))\n",
    "print(\"Latest dataset date:\", team_matches[\"match_date\"].max().date())\n"
   ]
  },
