    "# Task 2 — Router\n",
    "\n",
    "def classify_intent(query: str) -> str:\n",
    "    s = query.lower().strip()\n",
    "\n",
    "    prediction_patterns = [\n",
    "        r\"who will win\", r\"who wins\", r\"will .* beat\", r\"will .* win\",\n",
    "        r\"predict\", r\"prediction\", r\"likely to win\", r\"top[- ]score\",\n",
    "        r\"top scorer\", r\"leading scorer\", r\"who will score\"\n",
    "    ]\n",
    "    retrieval_words = [\n",
    "        \"stats\", \"statistics\", \"last round\", \"previous round\",\n",
    "        \"how many\", \"disposals\", \"goals\", \"marks\", \"tackles\",\n",
    "        \"fantasy points\", \"season average\", \"round\"\n",
    "    ]\n",
    "    factual_words = [\n",
    "        \"who is\", \"what is\", \"when did\", \"where is\", \"rules\",\n",
    "        \"history\", \"premiership\", \"coach\", \"founded\", \"how does\"\n",
    "    ]\n",
    "\n",
    "    if any(re.search(p, s) for p in prediction_patterns):\n",
    "        return \"prediction\"\n",
    "    if any(k in s for k in retrieval_words):\n",
    "        return \"retrieval\"\n",
    "    if any(k in s for k in factual_words):\n",
    "        return \"factual\"\n",
    "    return \"off-topic\"\n",
    "\n",
    "router_tests = [\n",
    "    (\"Who will win Collingwood vs Geelong?\", \"prediction\"),\n",
    "    (\"Will the Pies beat the Cats?\", \"prediction\"),\n",
    "    (\"Who will top-score for the Cats?\", \"prediction\"),\n",
    "    (\"Predict the leading scorer for Collingwood.\", \"prediction\"),\n",
    "    (\"What were Collingwood's stats last round?\", \"retrieval\"),\n",
    "    (\"How many disposals did Nick Daicos have last round?\", \"retrieval\"),\n",
    "    (\"What were Geelong's goals in the previous round?\", \"retrieval\"),\n",
    "    (\"Show the fantasy points for the Pies last round.\", \"retrieval\"),\n",
    "    (\"Who is the oldest AFL player in the dataset?\", \"factual\"),\n",
    "    (\"What are the basic AFL rules?\", \"factual\"),\n",
    "    (\"When did Geelong last win a premiership?\", \"factual\"),\n",
    "    (\"What is a mark in AFL?\", \"factual\"),\n",
    "    (\"Tell me a Python joke.\", \"off-topic\"),\n",
    "    (\"Write a poem about cricket.\", \"off-topic\"),\n",
    "    (\"What's the weather in Islamabad?\", \"off-topic\"),\n",
    "    (\"Predict Collingwood's tackles next week.\", \"prediction\"),\n",
    "    (\"How many goals did the Pies score last round?\", \"retrieval\"),\n",
    "    (\"Explain what machine learning is.\", \"off-topic\"),\n",
    "    (\"Who will win the match and why?\", \"prediction\"),\n",
    "    (\"Where is the AFL played?\", \"factual\"),\n",
    "]\n",
    "\n",
    "router_rows = []\n",
    "for q, expected in router_tests:\n",
    "    got = classify_intent(q)\n",
    "    router_rows.append({\"Query\": q, \"Expected\": expected, \"Routed\": got, \"Correct\": got == expected})\n",
    "\n",
    "routing_accuracy = pd.DataFrame(router_rows)\n",
    "routing_accuracy\n"
   ]
