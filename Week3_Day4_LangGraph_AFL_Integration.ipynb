    "# Local runner used only when LangGraph is unavailable here.\n",
    "# When LangGraph is installed, app.invoke(...) uses the real StateGraph above.\n",
    "\n",
    "def run_local(state):\n",
    "    state=dict(state)\n",
    "    state.setdefault(\"trace\",[])\n",
    "    state.update(router_node(state))\n",
    "    intent=state[\"intent\"]\n",
    "\n",
    "    if intent==\"factual\":\n",
    "        state.update(direct_answer_node(state))\n",
    "    elif intent==\"retrieval\":\n",
    "        state.update(retrieval_tool_node(state))\n",
    "        state.update(validation_graph_node(state))\n",
    "        if state[\"validation\"]==\"clarification\":\n",
    "            state.update(clarification_node(state))\n",
    "        elif state[\"validation\"]==\"fallback\":\n",
    "            state.update(fallback_node(state))\n",
    "    elif intent==\"prediction\":\n",
    "        state.update(prediction_tool_node(state))\n",
    "        state.update(validation_graph_node(state))\n",
    "        if state[\"validation\"]==\"clarification\":\n",
    "            state.update(clarification_node(state))\n",
    "        elif state[\"validation\"]==\"fallback\":\n",
    "            state.update(fallback_node(state))\n",
    "    else:\n",
    "        state.update(refusal_node(state))\n",
    "\n",
    "    state.update(response_formatter_node(state))\n",
    "    return state\n",
    "\n",
    "def run_app(query, history=None):\n",
    "    state={\"user_query\":query, \"conversation_history\":history or [], \"trace\":[]}\n",
    "    return app.invoke(state) if LANGGRAPH_AVAILABLE else run_local(state)\n",
    "\n",
    "demo=run_app(\"Will the Pies beat the Cats this week?\")\n",
    "print(demo[\"final_response\"])\n",
    "print(\"Trace:\")\n",
    "for x in demo[\"trace\"]:\n",
    "    print(x)\n"
   ]
