    "# Task 4 — Retrieval and helper functions\n",
    "\n",
    "def extract_team(query):\n",
    "    q = query.lower()\n",
    "    for alias, team in sorted(aliases.items(), key=lambda x: -len(x[0])):\n",
    "        if re.search(r\"\\b\" + re.escape(alias) + r\"\\b\", q):\n",
    "            return team\n",
    "    return None\n",
    "\n",
    "def extract_two_teams(query):\n",
    "    q = query.lower()\n",
    "    found=[]\n",
    "    for alias, team in sorted(aliases.items(), key=lambda x: -len(x[0])):\n",
    "        if re.search(r\"\\b\" + re.escape(alias) + r\"\\b\", q) and team not in found:\n",
    "            found.append(team)\n",
    "    return found[:2]\n",
    "\n",
    "def retrieve_team_last_match(team):\n",
    "    rows = team_matches[team_matches[\"team_name\"]==team].sort_values(\"match_date\")\n",
    "    if rows.empty:\n",
    "        return {\"ok\":False, \"error\":\"team_not_resolved\"}\n",
    "    r=rows.iloc[-1]\n",
    "    return {\n",
    "        \"ok\":True, \"team\":team, \"date\":str(r.match_date.date()),\n",
    "        \"opponent\":r.opponent, \"round\":str(r[\"round\"]),\n",
    "        \"result\":r.result, \"score\":int(r.team_score) if pd.notna(r.team_score) else None,\n",
    "        \"opponent_score\":int(r.opponent_score) if pd.notna(r.opponent_score) else None,\n",
    "        \"margin\":float(r.margin) if pd.notna(r.margin) else None\n",
    "    }\n",
    "\n",
    "def retrieve_player_last_game(player_text):\n",
    "    p = player_text.lower().strip()\n",
    "    matches = info[info[\"player_name\"].str.lower().eq(p)]\n",
    "    if matches.empty:\n",
    "        matches = info[info[\"player_name\"].str.lower().str.contains(re.escape(p), na=False)]\n",
    "    if len(matches) != 1:\n",
    "        return {\"ok\":False, \"error\":\"player_not_resolved\"}\n",
    "    pid = int(matches.iloc[0][\"id\"])\n",
    "    rows = round_stats[round_stats[\"player_id\"]==pid].sort_values(\"match_date\")\n",
    "    if rows.empty:\n",
    "        return {\"ok\":False, \"error\":\"player_data_missing\"}\n",
    "    r=rows.iloc[-1]\n",
    "    return {\n",
    "        \"ok\":True, \"player\":matches.iloc[0][\"player_name\"],\n",
    "        \"date\":str(r.match_date.date()), \"team\":r.team, \"opponent\":r.opponent,\n",
    "        \"disposals\":int(r.disposals) if pd.notna(r.disposals) else None,\n",
    "        \"goals\":int(r.goals) if pd.notna(r.goals) else None,\n",
    "        \"marks\":int(r.marks) if pd.notna(r.marks) else None,\n",
    "        \"fantasy_points\":int(r.fantasy_points) if pd.notna(r.fantasy_points) else None\n",
    "    }\n",
    "\n",
    "def is_unsupported_prediction(query):\n",
    "    q=query.lower()\n",
    "    unsupported=[\"tackles\",\"disposals\",\"marks\",\"fantasy points\"]\n",
    "    return any(x in q for x in unsupported) and not any(x in q for x in [\"top\",\"leading\",\"who will score\"])\n",
    "\n",
    "def retrieval_node_data(query):\n",
    "    team=extract_team(query)\n",
    "    if not team:\n",
    "        return {\"ok\":False,\"error\":\"team_not_resolved\"}\n",
    "    return retrieve_team_last_match(team)\n",
    "\n",
    "def validation_node(state):\n",
    "    result=state.get(\"tool_results\",{}).get(\"result\")\n",
    "    if not result or not result.get(\"ok\"):\n",
    "        err=(result or {}).get(\"error\",\"empty_result\")\n",
    "        if err in [\"team_not_resolved\",\"player_not_resolved\",\"fixture_not_found\",\"team_data_missing\",\"team_player_data_missing\"]:\n",
    "            return {\"validation\":\"clarification\",\"clarification_needed\":True}\n",
    "        return {\"validation\":\"fallback\",\"fallback_needed\":True}\n",
    "    return {\"validation\":\"valid\"}\n",
    "\n",
    "print(\"Validation examples:\")\n",
    "print(validation_node({\"tool_results\":{\"result\":{\"ok\":True}}}))\n",
    "print(validation_node({\"tool_results\":{\"result\":{\"ok\":False,\"error\":\"team_not_resolved\"}}}))\n",
    "print(validation_node({\"tool_results\":{\"result\":{\"ok\":False,\"error\":\"unsupported_prediction\"}}}))\n"
   ]
