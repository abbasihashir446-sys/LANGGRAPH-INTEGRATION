    "#  Setup and load the supplied AFL CSV files\n",
    "# Install once if needed in Colab:\n",
    "# %pip install -q langgraph langchain-core scikit-learn pandas numpy\n",
    "\n",
    "import os, re, json, math, warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from typing import TypedDict, Literal, Any\n",
    "\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "from sklearn.metrics import accuracy_score, roc_auc_score, mean_absolute_error\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "# The project now uses CSV files directly. No ZIP file is required.\n",
    "# Put these four CSV files in the same folder as this notebook,\n",
    "# or place them inside a folder named \"afl_datasets\".\n",
    "CSV_FILES = {\n",
    "    \"info\": \"afl_players_info.csv\",\n",
    "    \"round_stats\": \"afl_players_round_by_round_stats.csv\",\n",
    "    \"season_stats\": \"afl_players_seasonal_stats.csv\",\n",
    "    \"team_matches\": \"team_matches_home_away.csv\"\n",
    "}\n",
    "\n",
    "def find_csv(filename):\n",
    "    candidates = [\n",
    "        os.path.join(\"afl_datasets\", filename),\n",
    "        filename,\n",
    "        os.path.join(\"/content\", \"afl_datasets\", filename),\n",
    "        os.path.join(\"/content\", filename)\n",
    "    ]\n",
    "    for path in candidates:\n",
    "        if os.path.exists(path):\n",
    "            return path\n",
    "    raise FileNotFoundError(\n",
    "        f\"Could not find {filename}. Upload the four CSV files and keep their names unchanged.\"\n",
    "    )\n",
    "\n",
    "info = pd.read_csv(find_csv(CSV_FILES[\"info\"]), low_memory=False)\n",
    "round_stats = pd.read_csv(find_csv(CSV_FILES[\"round_stats\"]), low_memory=False)\n",
    "season_stats = pd.read_csv(find_csv(CSV_FILES[\"season_stats\"]), low_memory=False)\n",
    "team_matches = pd.read_csv(find_csv(CSV_FILES[\"team_matches\"]), low_memory=False)\n",
    "\n",
    "print(\"CSV files loaded successfully:\")\n",
    "print(\"players:\", info.shape)\n",
    "print(\"round stats:\", round_stats.shape)\n",
    "print(\"season stats:\", season_stats.shape)\n",
    "print(\"team matches:\", team_matches.shape)\n"
   ]
