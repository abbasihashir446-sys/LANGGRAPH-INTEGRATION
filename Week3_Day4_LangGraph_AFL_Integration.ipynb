    "# Task 3 — Tool wrappers and entity resolution\n",
    "\n",
    "try:\n",
    "    from langchain_core.tools import tool\n",
    "except Exception:\n",
    "    def tool(fn):\n",
    "        fn.invoke = fn\n",
    "        return fn\n",
    "\n",
    "def resolve_team(name):\n",
    "    s = name.lower().strip()\n",
    "    if s in aliases:\n",
    "        return aliases[s]\n",
    "    matches = [t for t in set(team_matches[\"team_name\"]) if s in t.lower()]\n",
    "    if len(matches) == 1:\n",
    "        return matches[0]\n",
    "    return None\n",
    "\n",
    "def latest_team_form(team):\n",
    "    rows = team_matches[team_matches[\"team_name\"] == team].sort_values(\"match_date\")\n",
    "    if rows.empty:\n",
    "        return None\n",
    "    last = rows.tail(5)\n",
    "    wins = (last[\"result\"].astype(str).str.upper() == \"W\").mean()\n",
    "    signed_margin = []\n",
    "    scores = []\n",
    "    for _, r in last.iterrows():\n",
    "        m = float(r[\"margin\"]) if pd.notna(r[\"margin\"]) else 0\n",
    "        signed_margin.append(m if str(r[\"result\"]).upper()==\"W\" else -m)\n",
    "        scores.append(float(r[\"team_score\"]) if pd.notna(r[\"team_score\"]) else 0)\n",
    "    return {\"win_rate\":wins, \"avg_margin\":np.mean(signed_margin), \"avg_score\":np.mean(scores)}\n",
    "\n",
    "def resolve_fixture(team1, team2, phrase=\"\"):\n",
    "    # The supplied dataset ends in 2025. No 2026 fixture can be invented.\n",
    "    if any(x in phrase.lower() for x in [\"this week\",\"next week\",\"upcoming\",\"next match\"]):\n",
    "        future = team_matches[\n",
    "            (team_matches[\"match_date\"] > team_matches[\"match_date\"].max()) &\n",
    "            (\n",
    "                ((team_matches[\"team_name\"]==team1)&(team_matches[\"opponent\"]==team2)) |\n",
    "                ((team_matches[\"team_name\"]==team2)&(team_matches[\"opponent\"]==team1))\n",
    "            )\n",
    "        ]\n",
    "        if future.empty:\n",
    "            return None\n",
    "        return future.sort_values(\"match_date\").iloc[0].to_dict()\n",
    "    return {}\n",
    "\n",
    "@tool\n",
    "def predict_match_winner(team1: str, team2: str, home_team: str = \"\") -> dict:\n",
    "    a, b = resolve_team(team1), resolve_team(team2)\n",
    "    if not a or not b:\n",
    "        return {\"ok\":False, \"error\":\"team_not_resolved\", \"team1\":team1, \"team2\":team2}\n",
    "\n",
    "    fa, fb = latest_team_form(a), latest_team_form(b)\n",
    "    if not fa or not fb:\n",
    "        return {\"ok\":False, \"error\":\"team_data_missing\"}\n",
    "\n",
    "    home_flag = 1 if resolve_team(home_team or \"\") == a else 0\n",
    "    x = pd.DataFrame([{\n",
    "        \"wr_diff\":fa[\"win_rate\"]-fb[\"win_rate\"],\n",
    "        \"margin_diff\":fa[\"avg_margin\"]-fb[\"avg_margin\"],\n",
    "        \"score_diff\":fa[\"avg_score\"]-fb[\"avg_score\"],\n",
    "        \"home_flag\":home_flag\n",
    "    }])\n",
    "    p_a = float(match_model.predict_proba(x)[0,1])\n",
    "    winner = a if p_a >= 0.5 else b\n",
    "    p_win = p_a if winner == a else 1-p_a\n",
    "\n",
    "    return {\n",
    "        \"ok\":True, \"winner\":winner, \"probability\":round(p_win,3),\n",
    "        \"teams\":[a,b],\n",
    "        \"features\":{\n",
    "            \"recent_win_rate_diff\":round(float(x.iloc[0][\"wr_diff\"]),3),\n",
    "            \"recent_margin_diff\":round(float(x.iloc[0][\"margin_diff\"]),2),\n",
    "            \"recent_score_diff\":round(float(x.iloc[0][\"score_diff\"]),2)\n",
    "        }\n",
    "    }\n",
    "\n",
    "@tool\n",
    "def predict_top_player(team: str) -> dict:\n",
    "    t = resolve_team(team)\n",
    "    if not t:\n",
    "        return {\"ok\":False, \"error\":\"team_not_resolved\", \"team\":team}\n",
    "\n",
    "    latest = round_stats[\n",
    "        (round_stats[\"team\"] == t) &\n",
    "        (round_stats[\"match_date\"] == round_stats[round_stats[\"team\"]==t][\"match_date\"].max())\n",
    "    ].copy()\n",
    "\n",
    "    if latest.empty:\n",
    "        return {\"ok\":False, \"error\":\"team_player_data_missing\"}\n",
    "\n",
    "    latest = latest.dropna(subset=[\"prev_fantasy_3\"])\n",
    "    if latest.empty:\n",
    "        return {\"ok\":False, \"error\":\"insufficient_player_history\"}\n",
    "\n",
    "    latest[\"predicted_fantasy\"] = player_model.predict(latest[player_cols])\n",
    "    latest = latest.sort_values(\"predicted_fantasy\", ascending=False).head(10)\n",
    "\n",
    "    scores = latest[\"predicted_fantasy\"].clip(lower=0).to_numpy()\n",
    "    exp_scores = np.exp((scores-scores.max())/15)\n",
    "    probs = exp_scores/exp_scores.sum()\n",
    "    latest[\"probability\"] = probs\n",
    "\n",
    "    r = latest.iloc[0]\n",
    "    return {\n",
    "        \"ok\":True,\n",
    "        \"team\":t,\n",
    "        \"player\":player_names.get(int(r.player_id), str(r.player_id)),\n",
    "        \"probability\":round(float(r.probability),3),\n",
    "        \"predicted_fantasy_points\":round(float(r.predicted_fantasy),1),\n",
    "        \"features\":{\n",
    "            \"previous_3_game_fantasy\":round(float(r.prev_fantasy_3),1),\n",
    "            \"previous_3_game_disposals\":round(float(r.prev_disposals_3),1),\n",
    "            \"previous_3_game_goals\":round(float(r.prev_goals_3),2)\n",
    "        }\n",
    "    }\n",
    "\n",
    "print(predict_match_winner(\"Pies\",\"Cats\"))\n",
    "print(predict_top_player(\"Pies\"))\n"
   ]
