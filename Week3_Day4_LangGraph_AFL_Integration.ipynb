    "# Task 4 — LangGraph implementation\n",
    "\n",
    "def add_trace(state, node, note=\"\"):\n",
    "    trace = list(state.get(\"trace\", []))\n",
    "    trace.append({\"node\":node, \"note\":note})\n",
    "    return {\"trace\":trace}\n",
    "\n",
    "def router_node(state):\n",
    "    intent=classify_intent(state[\"user_query\"])\n",
    "    out={\"intent\":intent,\"route\":intent}\n",
    "    out.update(add_trace(state,\"router\",f\"intent={intent}\"))\n",
    "    return out\n",
    "\n",
    "def direct_answer_node(state):\n",
    "    q=state[\"user_query\"].lower()\n",
    "    if \"how does\" in q or \"what is\" in q or \"rules\" in q:\n",
    "        answer=\"This assistant can answer AFL facts using the supplied dataset and basic AFL concepts.\"\n",
    "    else:\n",
    "        answer=\"The question is an AFL factual question. The answer should be grounded in the supplied AFL data where a dataset fact is requested.\"\n",
    "    out={\"tool_results\":{\"result\":{\"ok\":True,\"text\":answer}}}\n",
    "    out.update(add_trace(state,\"direct_answer\",\"factual response\"))\n",
    "    return out\n",
    "\n",
    "def retrieval_tool_node(state):\n",
    "    result=retrieval_node_data(state[\"user_query\"])\n",
    "    out={\"tool_results\":{\"result\":result}}\n",
    "    out.update(add_trace(state,\"retrieval_tool\",str(result)))\n",
    "    return out\n",
    "\n",
    "def prediction_tool_node(state):\n",
    "    q=state[\"user_query\"]\n",
    "    teams=extract_two_teams(q)\n",
    "\n",
    "    if is_unsupported_prediction(q):\n",
    "        result={\"ok\":False,\"error\":\"unsupported_prediction\"}\n",
    "    elif \"top\" in q.lower() or \"leading scorer\" in q.lower() or \"top-score\" in q.lower():\n",
    "        result=predict_top_player(teams[0] if teams else \"\")\n",
    "    elif len(teams)>=2:\n",
    "        fixture=resolve_fixture(teams[0],teams[1],q)\n",
    "        if any(x in q.lower() for x in [\"this week\",\"next week\",\"upcoming\",\"next match\"]) and fixture is None:\n",
    "            result={\"ok\":False,\"error\":\"fixture_not_found\",\"teams\":teams}\n",
    "        else:\n",
    "            home_team=fixture.get(\"team_name\",\"\") if fixture else \"\"\n",
    "            result=predict_match_winner(teams[0],teams[1],home_team)\n",
    "            if fixture:\n",
    "                result[\"fixture_date\"]=str(pd.to_datetime(fixture[\"match_date\"]).date())\n",
    "    else:\n",
    "        result={\"ok\":False,\"error\":\"team_not_resolved\"}\n",
    "\n",
    "    out={\"tool_results\":{\"result\":result}}\n",
    "    out.update(add_trace(state,\"prediction_tool\",str(result)))\n",
    "    return out\n",
    "\n",
    "def refusal_node(state):\n",
    "    out={\"tool_results\":{\"result\":{\"ok\":True,\"text\":\"Sorry, I can only help with AFL teams, players, matches, statistics, history, rules, and the prediction types supported by this application.\"}}}\n",
    "    out.update(add_trace(state,\"refusal\",\"off-topic request\"))\n",
    "    return out\n",
    "\n",
    "def validation_graph_node(state):\n",
    "    out=validation_node(state)\n",
    "    out.update(add_trace(state,\"validation\",out[\"validation\"]))\n",
    "    return out\n",
    "\n",
    "def clarification_node(state):\n",
    "    r=state.get(\"tool_results\",{}).get(\"result\",{})\n",
    "    if r.get(\"error\")==\"fixture_not_found\":\n",
    "        text=(\"I can resolve the team aliases, but the supplied dataset ends on 2025-09-27 \"\n",
    "              \"and contains no later fixture. Please provide a fixture/date that exists in the dataset.\")\n",
    "    elif r.get(\"error\")==\"unsupported_prediction\":\n",
    "        text=(\"That prediction type is outside this model. I support match-winner probability \"\n",
    "              \"and top-player prediction, not individual tackles/disposals/marks/fantasy-point forecasts.\")\n",
    "    else:\n",
    "        text=\"I could not resolve the team or player unambiguously. Please provide the exact team/player name.\"\n",
    "    out={\"tool_results\":{\"result\":{\"ok\":True,\"text\":text}}}\n",
    "    out.update(add_trace(state,\"clarification\",\"ask for missing/ambiguous information\"))\n",
    "    return out\n",
    "\n",
    "def fallback_node(state):\n",
    "    text=\"I could not obtain a valid tool result, so I will not guess. Please provide a supported AFL query with the required team/player information.\"\n",
    "    out={\"tool_results\":{\"result\":{\"ok\":True,\"text\":text}}}\n",
    "    out.update(add_trace(state,\"fallback\",\"safe no-guess path\"))\n",
    "    return out\n",
    "\n",
    "def response_formatter_node(state):\n",
    "    r=state.get(\"tool_results\",{}).get(\"result\",{})\n",
    "    if state.get(\"intent\")==\"prediction\" and r.get(\"ok\") and \"winner\" in r:\n",
    "        text=(f\"Model prediction: {r['winner']} — probability {r['probability']:.1%}. \"\n",
    "              f\"This is probabilistic, not certain. Grounding: recent win-rate difference \"\n",
    "              f\"{r['features']['recent_win_rate_diff']:+.2f}, recent margin difference \"\n",
    "              f\"{r['features']['recent_margin_diff']:+.1f}, and recent score difference \"\n",
    "              f\"{r['features']['recent_score_diff']:+.1f}.\")\n",
    "        if r.get(\"fixture_date\"):\n",
    "            text += f\" Fixture date in the dataset: {r['fixture_date']}.\"\n",
    "    elif state.get(\"intent\")==\"prediction\" and r.get(\"ok\") and \"player\" in r:\n",
    "        text=(f\"Model top-player prediction: {r['player']} — relative probability \"\n",
    "              f\"{r['probability']:.1%}, predicted fantasy points {r['predicted_fantasy_points']:.1f}. \"\n",
    "              f\"This is probabilistic, not certain. Grounding: previous-3-game fantasy \"\n",
    "              f\"{r['features']['previous_3_game_fantasy']:.1f}, disposals \"\n",
    "              f\"{r['features']['previous_3_game_disposals']:.1f}, and goals \"\n",
    "              f\"{r['features']['previous_3_game_goals']:.2f}.\")\n",
    "    elif \"text\" in r:\n",
    "        text=r[\"text\"]\n",
    "    elif state.get(\"intent\")==\"retrieval\" and r.get(\"ok\"):\n",
    "        text=(f\"{r['team']}'s latest recorded match was on {r['date']} against {r['opponent']} \"\n",
    "              f\"(round {r['round']}): {r['result']}, score {r['score']}-{r['opponent_score']}, \"\n",
    "              f\"margin {r['margin']}.\")\n",
    "    else:\n",
    "        text=\"No response was produced.\"\n",
    "    out={\"final_response\":text}\n",
    "    out.update(add_trace(state,\"response_formatter\",\"final response\"))\n",
    "    return out\n",
    "\n",
    "# Real LangGraph if installed.\n",
    "try:\n",
    "    from langgraph.graph import StateGraph, START, END\n",
    "    LANGGRAPH_AVAILABLE=True\n",
    "\n",
    "    graph=StateGraph(AFLState)\n",
    "    graph.add_node(\"router\",router_node)\n",
    "    graph.add_node(\"direct_answer\",direct_answer_node)\n",
    "    graph.add_node(\"retrieval_tool\",retrieval_tool_node)\n",
    "    graph.add_node(\"prediction_tool\",prediction_tool_node)\n",
    "    graph.add_node(\"refusal\",refusal_node)\n",
    "    graph.add_node(\"validation\",validation_graph_node)\n",
    "    graph.add_node(\"clarification\",clarification_node)\n",
    "    graph.add_node(\"fallback\",fallback_node)\n",
    "    graph.add_node(\"response_formatter\",response_formatter_node)\n",
    "\n",
    "    graph.add_edge(START,\"router\")\n",
    "    graph.add_conditional_edges(\"router\",lambda s:s[\"intent\"],{\n",
    "        \"factual\":\"direct_answer\",\"retrieval\":\"retrieval_tool\",\n",
    "        \"prediction\":\"prediction_tool\",\"off-topic\":\"refusal\"\n",
    "    })\n",
    "    graph.add_edge(\"direct_answer\",\"response_formatter\")\n",
    "    graph.add_edge(\"retrieval_tool\",\"validation\")\n",
    "    graph.add_edge(\"prediction_tool\",\"validation\")\n",
    "    graph.add_conditional_edges(\"validation\",lambda s:s[\"validation\"],{\n",
    "        \"valid\":\"response_formatter\",\"clarification\":\"clarification\",\"fallback\":\"fallback\"\n",
    "    })\n",
    "    graph.add_edge(\"refusal\",\"response_formatter\")\n",
    "    graph.add_edge(\"clarification\",\"response_formatter\")\n",
    "    graph.add_edge(\"fallback\",\"response_formatter\")\n",
    "    graph.add_edge(\"response_formatter\",END)\n",
    "    app=graph.compile()\n",
    "    print(\"LangGraph StateGraph compiled successfully.\")\n",
    "except Exception as e:\n",
    "    LANGGRAPH_AVAILABLE=False\n",
    "    app=None\n",
    "    print(\"LangGraph is not installed in this environment.\")\n",
    "    print(\"The notebook will use the same node logic with a local fallback runner.\")\n"
   ]
