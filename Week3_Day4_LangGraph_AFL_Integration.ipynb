      "{'ok': True, 'team': 'Collingwood Magpies', 'player': 'Nick Daicos', 'probability': 0.245, 'predicted_fantasy_points': 100.7, 'features': {'previous_3_game_fantasy': 98.3, 'previous_3_game_disposals': 31.0, 'previous_3_game_goals': 0.33}}\n"
